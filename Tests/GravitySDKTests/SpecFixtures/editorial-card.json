{
  "name": "editorial-card",
  "source": "observability REFERENCE_SPECS",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "editorial-card",
    "root": {
      "type": "link",
      "bind": "url",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "10px",
        "maxWidth": "420px",
        "padding": "16px 18px",
        "background": "hsl(var(--card))",
        "border": "1px solid hsl(var(--border))",
        "borderRadius": "var(--radius)",
        "textDecoration": "none",
        "color": "hsl(var(--foreground))"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "8px"
          },
          "children": [
            {
              "type": "image",
              "bind": "favicon",
              "style": {
                "width": "18px",
                "height": "18px",
                "borderRadius": "4px"
              }
            },
            {
              "type": "text",
              "bind": "brandName",
              "style": {
                "fontSize": "12px",
                "fontWeight": 600,
                "color": "hsl(var(--muted-foreground))",
                "letterSpacing": "0.01em"
              }
            },
            {
              "type": "text",
              "text": "Sponsored",
              "style": {
                "marginLeft": "auto",
                "fontSize": "10px",
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "color": "hsl(var(--muted-foreground))",
                "opacity": 0.7
              }
            }
          ]
        },
        {
          "type": "text",
          "bind": "title",
          "style": {
            "fontSize": "16px",
            "fontWeight": 600,
            "lineHeight": 1.3
          }
        },
        {
          "type": "text",
          "bind": "adText",
          "showIf": "adText",
          "style": {
            "fontSize": "13px",
            "lineHeight": 1.5,
            "color": "hsl(var(--muted-foreground))"
          }
        },
        {
          "type": "text",
          "bind": "cta",
          "style": {
            "alignSelf": "flex-start",
            "marginTop": "4px",
            "padding": "8px 16px",
            "borderRadius": "999px",
            "background": "hsl(var(--primary))",
            "color": "hsl(var(--primary-foreground))",
            "fontSize": "13px",
            "fontWeight": 600
          }
        }
      ]
    }
  }
}
