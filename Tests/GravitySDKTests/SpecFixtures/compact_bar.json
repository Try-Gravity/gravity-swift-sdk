{
  "name": "compact_bar",
  "source": "engine spec_library",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "compact_bar",
    "root": {
      "type": "link",
      "style": {
        "display": "flex",
        "alignItems": "center",
        "gap": "12px",
        "flexWrap": "wrap",
        "padding": "8px 14px",
        "borderRadius": "var(--radius, 0.625rem)",
        "background": "hsl(var(--card))",
        "border": "1px solid hsl(var(--border))",
        "boxShadow": "0 1px 2px 0 hsl(var(--foreground) / 0.05), 0 2px 8px 0 hsl(var(--foreground) / 0.08)"
      },
      "children": [
        {
          "type": "image",
          "bind": "favicon",
          "showIf": "favicon",
          "style": {
            "width": "34px",
            "height": "34px",
            "borderRadius": "7px",
            "objectFit": "contain",
            "flexShrink": 0
          }
        },
        {
          "type": "box",
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "4px",
            "flex": "1 1 160px",
            "minWidth": "0"
          },
          "children": [
            {
              "type": "text",
              "text": "Sponsored",
              "style": {
                "fontSize": "10.5px",
                "fontWeight": 700,
                "letterSpacing": "0.06em",
                "textTransform": "uppercase",
                "color": "hsl(var(--muted-foreground))",
                "lineHeight": "1"
              }
            },
            {
              "type": "box",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "8px"
              },
              "children": [
                {
                  "type": "text",
                  "bind": "brandName",
                  "showIf": "brandName",
                  "style": {
                    "fontSize": "13px",
                    "fontWeight": 600,
                    "color": "hsl(var(--card-foreground))",
                    "lineHeight": "1"
                  }
                },
                {
                  "type": "text",
                  "bind": "adText",
                  "showIf": "adText",
                  "style": {
                    "fontSize": "12.5px",
                    "color": "hsl(var(--muted-foreground))",
                    "margin": "0",
                    "lineHeight": "1.5"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "bind": "cta",
          "showIf": "cta",
          "style": {
            "display": "inline-flex",
            "alignItems": "center",
            "justifyContent": "center",
            "gap": "6px",
            "padding": "9px 18px",
            "fontSize": "13px",
            "fontWeight": 600,
            "lineHeight": "1",
            "whiteSpace": "nowrap",
            "color": "hsl(var(--primary-foreground))",
            "background": "hsl(var(--primary))",
            "borderRadius": "7px",
            "flexShrink": 0,
            "marginLeft": "auto"
          }
        }
      ]
    }
  }
}
