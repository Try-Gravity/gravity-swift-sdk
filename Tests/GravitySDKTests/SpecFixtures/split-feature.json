{
  "name": "split-feature",
  "source": "observability REFERENCE_SPECS",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "split-feature",
    "root": {
      "type": "link",
      "bind": "url",
      "style": {
        "display": "flex",
        "alignItems": "center",
        "gap": "14px",
        "maxWidth": "460px",
        "padding": "14px",
        "background": "hsl(var(--card))",
        "border": "1px solid hsl(var(--border))",
        "borderRadius": "var(--radius)",
        "textDecoration": "none",
        "color": "hsl(var(--foreground))"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "center",
            "width": "56px",
            "height": "56px",
            "flexShrink": 0,
            "borderRadius": "12px",
            "background": "hsl(var(--muted))"
          },
          "children": [
            {
              "type": "image",
              "bind": "favicon",
              "style": {
                "width": "32px",
                "height": "32px",
                "borderRadius": "8px"
              }
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "3px",
            "flex": "1",
            "minWidth": "0"
          },
          "children": [
            {
              "type": "text",
              "bind": "title",
              "style": {
                "fontSize": "15px",
                "fontWeight": 600,
                "lineHeight": 1.3
              }
            },
            {
              "type": "text",
              "bind": "adText",
              "showIf": "adText",
              "style": {
                "fontSize": "12px",
                "color": "hsl(var(--muted-foreground))",
                "lineHeight": 1.4
              }
            }
          ]
        },
        {
          "type": "text",
          "bind": "cta",
          "style": {
            "flexShrink": 0,
            "padding": "8px 14px",
            "borderRadius": "8px",
            "background": "hsl(var(--primary))",
            "color": "hsl(var(--primary-foreground))",
            "fontSize": "13px",
            "fontWeight": 600
          }
        }
      ]
    }
  }
}
