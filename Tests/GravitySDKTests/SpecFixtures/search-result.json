{
  "name": "search-result",
  "source": "observability REFERENCE_SPECS",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "search-result",
    "root": {
      "type": "box",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "3px",
        "maxWidth": "520px"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "7px"
          },
          "children": [
            {
              "type": "image",
              "bind": "favicon",
              "style": {
                "width": "16px",
                "height": "16px",
                "borderRadius": "50%"
              }
            },
            {
              "type": "text",
              "bind": "brandName",
              "style": {
                "fontSize": "12px",
                "color": "hsl(var(--foreground))"
              }
            },
            {
              "type": "text",
              "text": "\u00b7 Ad",
              "style": {
                "fontSize": "12px",
                "color": "hsl(var(--muted-foreground))"
              }
            }
          ]
        },
        {
          "type": "link",
          "bind": "url",
          "style": {
            "fontSize": "18px",
            "fontWeight": 500,
            "color": "hsl(var(--primary))",
            "textDecoration": "none",
            "lineHeight": 1.3
          },
          "children": [
            {
              "type": "text",
              "bind": "title"
            }
          ]
        },
        {
          "type": "text",
          "bind": "adText",
          "showIf": "adText",
          "style": {
            "fontSize": "13px",
            "lineHeight": 1.5,
            "color": "hsl(var(--muted-foreground))"
          }
        }
      ]
    }
  }
}
