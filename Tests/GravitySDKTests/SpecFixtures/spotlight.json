{
  "name": "spotlight",
  "source": "engine spec_library",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "spotlight",
    "root": {
      "type": "link",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "12px",
        "padding": "20px",
        "borderRadius": "var(--radius, 0.625rem)",
        "background": "hsl(var(--muted) / 0.45)",
        "border": "1px solid hsl(var(--border))",
        "boxShadow": "0 1px 2px 0 hsl(var(--foreground) / 0.05), 0 2px 8px 0 hsl(var(--foreground) / 0.08)"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "8px"
          },
          "children": [
            {
              "type": "image",
              "bind": "favicon",
              "showIf": "favicon",
              "style": {
                "width": "22px",
                "height": "22px",
                "borderRadius": "5px",
                "objectFit": "contain",
                "flexShrink": 0
              }
            },
            {
              "type": "text",
              "bind": "brandName",
              "showIf": "brandName",
              "style": {
                "fontSize": "13.5px",
                "fontWeight": 600,
                "color": "hsl(var(--card-foreground))",
                "lineHeight": "1"
              }
            },
            {
              "type": "text",
              "text": "AD",
              "style": {
                "fontSize": "10px",
                "fontWeight": 600,
                "letterSpacing": "0.04em",
                "color": "hsl(var(--muted-foreground))",
                "background": "hsl(var(--muted))",
                "padding": "3px 7px",
                "borderRadius": "5px",
                "lineHeight": "1",
                "flexShrink": 0,
                "marginLeft": "auto"
              }
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "7px",
            "minWidth": "0"
          },
          "children": [
            {
              "type": "text",
              "bind": "title",
              "showIf": "title",
              "style": {
                "fontSize": "20px",
                "fontWeight": 700,
                "color": "hsl(var(--card-foreground))",
                "margin": "0",
                "lineHeight": "1.35"
              }
            },
            {
              "type": "text",
              "bind": "adText",
              "showIf": "adText",
              "style": {
                "fontSize": "13.5px",
                "color": "hsl(var(--muted-foreground))",
                "margin": "0",
                "lineHeight": "1.5"
              }
            }
          ]
        },
        {
          "type": "text",
          "bind": "cta",
          "showIf": "cta",
          "style": {
            "display": "inline-flex",
            "alignItems": "center",
            "justifyContent": "center",
            "gap": "6px",
            "padding": "11px 18px",
            "fontSize": "13px",
            "fontWeight": 600,
            "lineHeight": "1",
            "whiteSpace": "nowrap",
            "color": "hsl(var(--primary-foreground))",
            "background": "hsl(var(--primary))",
            "borderRadius": "7px",
            "width": "100%"
          }
        }
      ]
    }
  }
}
