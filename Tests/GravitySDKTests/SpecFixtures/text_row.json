{
  "name": "text_row",
  "source": "engine spec_library",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "text_row",
    "root": {
      "type": "link",
      "style": {
        "display": "flex",
        "alignItems": "center",
        "gap": "12px",
        "padding": "10px 6px",
        "background": "transparent"
      },
      "children": [
        {
          "type": "image",
          "bind": "favicon",
          "showIf": "favicon",
          "style": {
            "width": "36px",
            "height": "36px",
            "borderRadius": "9px",
            "objectFit": "contain",
            "flexShrink": 0
          }
        },
        {
          "type": "box",
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "3px",
            "minWidth": "0"
          },
          "children": [
            {
              "type": "text",
              "bind": "title",
              "showIf": "title",
              "style": {
                "fontSize": "15px",
                "fontWeight": 600,
                "color": "hsl(var(--card-foreground))",
                "margin": "0",
                "lineHeight": "1.35"
              }
            },
            {
              "type": "box",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "5px",
                "minWidth": "0"
              },
              "children": [
                {
                  "type": "text",
                  "bind": "brandName",
                  "showIf": "brandName",
                  "style": {
                    "fontSize": "12.5px",
                    "color": "hsl(var(--muted-foreground))",
                    "lineHeight": "1.2"
                  }
                },
                {
                  "type": "text",
                  "text": "\u00b7",
                  "style": {
                    "fontSize": "12.5px",
                    "color": "hsl(var(--muted-foreground))",
                    "lineHeight": "1.2"
                  }
                },
                {
                  "type": "text",
                  "text": "Sponsored",
                  "style": {
                    "fontSize": "12.5px",
                    "color": "hsl(var(--muted-foreground))",
                    "lineHeight": "1.2"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
