{
  "name": "outline-cta",
  "source": "observability REFERENCE_SPECS",
  "expect": {
    "structureValid": true,
    "psp1": false
  },
  "spec": {
    "version": 1,
    "name": "outline-cta",
    "root": {
      "type": "link",
      "bind": "url",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "8px",
        "maxWidth": "400px",
        "padding": "16px",
        "background": "hsl(var(--card))",
        "border": "1px solid hsl(var(--border))",
        "borderRadius": "var(--radius)",
        "textDecoration": "none",
        "color": "hsl(var(--foreground))"
      },
      "children": [
        {
          "type": "text",
          "bind": "brandName",
          "style": {
            "fontSize": "11px",
            "textTransform": "uppercase",
            "letterSpacing": "0.08em",
            "color": "hsl(var(--muted-foreground))"
          }
        },
        {
          "type": "text",
          "bind": "title",
          "style": {
            "fontSize": "16px",
            "fontWeight": 600,
            "lineHeight": 1.3
          }
        },
        {
          "type": "text",
          "bind": "adText",
          "showIf": "adText",
          "style": {
            "fontSize": "13px",
            "color": "hsl(var(--muted-foreground))",
            "lineHeight": 1.5
          }
        },
        {
          "type": "text",
          "bind": "cta",
          "style": {
            "alignSelf": "flex-start",
            "marginTop": "4px",
            "padding": "7px 16px",
            "borderRadius": "8px",
            "border": "1px solid hsl(var(--primary))",
            "color": "hsl(var(--primary))",
            "fontSize": "13px",
            "fontWeight": 600
          }
        }
      ]
    }
  }
}
